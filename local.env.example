# Подключение к локальной PostgreSQL. Базу и пользователя нужно создать заранее.
# Реактивное подключение приложения.
R2DBC_URL=r2dbc:postgresql://localhost:5432/my_market_app
# JDBC используется только Liquibase при запуске.
JDBC_URL=jdbc:postgresql://localhost:5432/my_market_app
DB_USERNAME=market
DB_PASSWORD=market

# Схема должна существовать до запуска приложения.
DB_SCHEMA=public

# HTTP-порт приложения.
SERVER_PORT=8080

# Пути к изображениям относительно рабочего каталога и к заглушке внутри него.
IMAGES_ROOT=images
IMAGES_DEFAULT_IMAGE=default-image.svg

# Однократная загрузка демонстрационных товаров и заказов.
INSERT_DEMO_DATA=true
