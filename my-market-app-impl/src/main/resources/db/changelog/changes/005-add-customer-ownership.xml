<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="005-add-customer-ownership" author="yakovlev">
        <addColumn tableName="cart_items" schemaName="${appSchema}">
            <column name="user_id" type="BIGINT"/>
        </addColumn>
        <addColumn tableName="orders" schemaName="${appSchema}">
            <column name="user_id" type="BIGINT"/>
        </addColumn>

        <update tableName="cart_items" schemaName="${appSchema}">
            <column name="user_id" valueNumeric="1"/>
        </update>
        <update tableName="orders" schemaName="${appSchema}">
            <column name="user_id" valueNumeric="1"/>
        </update>
        <addNotNullConstraint tableName="cart_items" schemaName="${appSchema}" columnName="user_id" columnDataType="BIGINT"/>
        <addNotNullConstraint tableName="orders" schemaName="${appSchema}" columnName="user_id" columnDataType="BIGINT"/>

        <addForeignKeyConstraint constraintName="cart_items_user_fk"
                                 baseTableSchemaName="${appSchema}" baseTableName="cart_items" baseColumnNames="user_id"
                                 referencedTableSchemaName="${appSchema}" referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="orders_user_fk"
                                 baseTableSchemaName="${appSchema}" baseTableName="orders" baseColumnNames="user_id"
                                 referencedTableSchemaName="${appSchema}" referencedTableName="users" referencedColumnNames="id"/>
        <createIndex indexName="orders_user_created_at_id_idx" tableName="orders" schemaName="${appSchema}">
            <column name="user_id"/>
            <column name="created_at" descending="true"/>
            <column name="id" descending="true"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="orders_user_created_at_id_idx" tableName="orders" schemaName="${appSchema}"/>
            <dropForeignKeyConstraint baseTableName="orders" baseTableSchemaName="${appSchema}" constraintName="orders_user_fk"/>
            <dropForeignKeyConstraint baseTableName="cart_items" baseTableSchemaName="${appSchema}" constraintName="cart_items_user_fk"/>
            <dropColumn tableName="orders" schemaName="${appSchema}" columnName="user_id"/>
            <dropColumn tableName="cart_items" schemaName="${appSchema}" columnName="user_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
